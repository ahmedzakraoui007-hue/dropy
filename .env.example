# Copy to .env.local for local development and add the same keys in Vercel.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site address, used in emails and links
NEXT_PUBLIC_SITE_URL=https://dropy.store

# Email (SMTP) for signup confirmation, password reset and account approval
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dropy <ahmed@dropy.store>"

# Free launch: everything free, subscriptions and Stripe off. Set to "false" when paid plans start.
NEXT_PUBLIC_FREE_LAUNCH=true

# Optional
UNSPLASH_ACCESS_KEY=
DELIVERY_WEBHOOK_SECRET=
TUNISIE_LIVRAISON_API_KEY=
TUNISIE_LIVRAISON_API_URL=
